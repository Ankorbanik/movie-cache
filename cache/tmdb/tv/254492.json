ruck","vote_average":6.596,"vote_count":68}],"total_pages":1001,"total_results":20001}},"sources":{"tmdb":true,"omdb":true,"fanart":true},"omdb":{"Title":"Hana-Kimi","Year":"2026–","Rated":"N/A","Released":"04 Jan 2026","Runtime":"N/A","Genre":"Animation, Comedy, Drama","Director":"N/A","Writer":"N/A","Actors":"Kikunosuke Toya, Taku Yashiro, Aya Yamane","Plot":"A Japanese-American athlete transfers to an all-boys school in Japan to be near her sports idol. Disguised as a boy, she becomes his roommate and must keep her identity secret while dealing with unexpected feelings and confusion.","Language":"Japanese","Country":"Japan","Awards":"N/A","Poster":"https://m.media-amazon.com/images/M/MV5BZGE4N2QxMWYtYTJkMi00YmY0LThlYzctZWZmNjFmZjMxOTc5XkEyXkFqcGc@._V1_QL75_UX380_CR0,4,380,562_.jpg","Ratings":[{"Source":"Internet Movie Database","Value":"6.5/10"}],"Metascore":"N/A","imdbRating":"6.5","imdbVotes":"596","imdbID":"tt38646611","Type":"series","totalSeasons":"1","Response":"True"},"fanart":{"hdtvlogo":[{"copyright":"Unknown","id":"197471","lang":"en","likes":"0","url":"https://assets.fanart.tv/fanart/hana-kimi-678ce81087b31.png"},{"copyright":"Unknown","id":"203675","lang":"en","likes":"0","url":"https://assets.fanart.tv/fanart/hana-kimi-68ef5d816bb58.png"},{"copyright":"Unknown","id":"208199","lang":"en","likes":"0","url":"https://assets.fanart.tv/fanart/hana-kimi-694ce8607945e.png"}],"hdtvlogo_count":3,"name":"Hana-Kimi","thetvdb_id":"450072","tvposter":[{"copyright":"Signal.MD, Aniplex, Crunchyroll","id":"203712","lang":"00","likes":"0","url":"https://assets.fanart.tv/fanart/hana-kimi-68efbb4f226cc.jpg"}],"tvposter_count":1}}