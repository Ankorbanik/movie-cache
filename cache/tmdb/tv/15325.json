s-related broadcasts on NRK include Dagsrevyen 21, Kveldsnytt, Standpunkt, RedaksjonEN, Urix and Dagsnytt, plus the radio shows Ukeslutt, Dagsnytt 18 and Her og Nå. NRK also broadcasts daily newscasts from most regional offices.","popularity":365.7915,"poster_path":"/5wGSp6VaXG406ZbgQoJizPKUE79.jpg","production_companies":[{"id":109843,"logo_path":"/iwkwIEXWIPApzedElW5sY8LFZSx.png","name":"NRK","origin_country":"NO"}],"production_countries":[{"iso_3166_1":"NO","name":"Norway"}],"seasons":[{"air_date":"1958-12-02","episode_count":9,"id":373071,"name":"Season 1","overview":"","poster_path":null,"season_number":1,"vote_average":0},{"air_date":"1959-01-02","episode_count":104,"id":373072,"name":"Season 2","overview":"","poster_path":null,"season_number":2,"vote_average":0},{"air_date":"1960-01-01","episode_count":127,"id":546198,"name":"Season 3","overview":"","poster_path":null,"season_number":3,"vote_average":0},{"air_date":"1961-01-03","episode_count":156,"id":546199,"name":"Season 4","overview":"","poster_path":null,"season_number":4,"vote_average":0},{"air_date":"1962-01-01","episode_count":210,"id":546200,"name":"Season 5","overview":"","poster_path":null,"season_number":5,"vote_average":0},{"air_date":"1963-01-01","episode_count":261,"id":546201,"name":"Season 6","overview":"","poster_path":null,"season_number":6,"vote_average":0},{"air_date":"1964-01-01","episode_count":314,"id":546202,"name":"Season 7","overview":"","poster_path":null,"season_number":7,"vote_average":0},{"air_date":"1965-01-01","episode_count":313,"id":546203,"name":"Season 8","overview":"","poster_path":null,"season_number":8,"vote_average":0},{"air_date":"1966-01-01","episode_count":313,"id":546204,"name":"Season 9","overview":"","poster_path":null,"season_number":9,"vote_average":0},{"air_date":"1967-01-02","episode_count":260,"id":546205,"name":"Season 10","overview":"","poster_path":null,"season_number":10,"vote_average":0},{"air_date":"1968-01-01","episode_count":267,"id":546206,"name":"S