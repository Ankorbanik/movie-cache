h/providers":{"results":{}},"similar":{"page":1,"results":[{"adult":false,"backdrop_path":"/1S81PpyGwS8eVx4W75uSKzMw4B0.jpg","genre_ids":[18],"id":404,"title":"The Straight Story","original_language":"en","original_title":"The Straight Story","overview":"Retired farmer and widower Alvin Straight learns one day that his estranged brother Lyle has suffered a severe stroke. Alvin is determined to make things right with Lyle while he still can, but his brother lives in Wisconsin, while Alvin is stuck in Iowa with no car and no driver's license. He then has the idea of making the trip on his old lawnmower, thus beginning a picturesque and at times deeply spiritual odyssey.","popularity":9.5452,"poster_path":"/tT9cMiVDdtlcdZxOoFy3VRmEoKk.jpg","release_date":"1999-10-15","softcore":false,"video":false,"vote_average":7.735,"vote_count":1899},{"adult":false,"backdrop_path":"/c0fB9xk7D1aVb3Bg2rk2SVJcGn.jpg","genre_ids":[18,10752],"id":423,"title":"The Pianist","original_language":"en","original_title":"The Pianist","overview":"The true story of pianist Władysław Szpilman's experiences in Warsaw during the Nazi occupation. When the Jews of the city find themselves forced into a ghetto, Szpilman finds work playing in a café; and when his family is deported in 1942, he stays behind, works for a while as a laborer, and eventually goes into hiding in the ruins of the war-torn city.","popularity":24.6455,"poster_path":"/2hFvxCCWrTmCYwfy7yum0GKRi3Y.jpg","release_date":"2002-09-17","softcore":false,"video":false,"vote_average":8.369,"vote_count":10541},{"adult":false,"backdrop_path":"/h7vBO0meGzjW3yu0Gejx5hI09I9.jpg","genre_ids":[18,36],"id":549,"title":"Basquiat","original_language":"en","original_title":"Basquiat","overview":"The brief life of Jean Michel Basquiat, a world renowned New York street artist struggling with fame, drugs and his identity.","popularity":3.9808,"poster_path":"/gFfVhN8BbgHhMb3ZNQRAH5xc7kq.jpg","release_date":"1996-08-09","softcore":false,"video":false,"vote_average":6.6,"vote_count":327},{"adult":false,"backdrop_path":"/ggC3Brchf4RqPitEh7cROFoeAWn.jpg","genre_ids":[18,80],"id":640,"title":"Catch Me If You Can","original_language":"en","original_title":"Catch Me If You Can","overview":"A true story about Frank Abagnale Jr. who, before his 19th birthday, successfully conned millions of dollars worth of checks as a Pan Am pilot, doctor, and legal prosecutor. An FBI agent makes it his mission to put him behind bars. But Frank not only eludes capture, he revels in the pursuit.","popularity":34.9027,"poster_path":"/ctjEj2xM32OvBXCq8zAdK3ZrsAj.jpg","release_date":"2002-12-16","softcore":false,"video":false,"vote_average":7.978,"vote_count":17727},{"adult":false,"backdrop_path":"/5rVuIi8h04MPsuJXri7NGRO5FsY.jpg","genre_ids":[18],"id":265095,"title":"Anna Pavlova","original_language":"ru","original_title":"Анна Павлова","overview":"The young talented girl Anya, dreaming of a ballet, enters the choreographic school. Due to poor health, learning for her becomes unbearably difficult, but dreams of a ballerina career make her stubbornly deal with adversity. Anna’s performance and determination does not go unnoticed by the celebrated choreographer Marius Petipa, who helps to stage Pavlova's examination performance. Such a gift becomes a starting point for Ani in the world of big ballet, her fast-paced career, position in high society and world fame make her forget about close friends and especially her faithful Michel Fokine, who invested a lot of energy in the formation of a ballerina.","popularity":1.595,"poster_path":"/3dvkSl54hnOFhWTj0cnwCEDgPs5.jpg","release_date":"1983-08-01","softcore":false,"video":false,"vote_average":4.9,"vote_count":9},{"adult":false,"backdrop_path":"/rKs8y5WlXcYX5GCbDkXcXybGteZ.jpg","genre_ids":[35,18,10749],"id":457,"title":"Sissi","original_language":"de","original_title":"Sissi","overview":"The young Bavarian princess Elisabeth, who all call Sissi, goes with her mother and older sister Néné to Austria where Néné will be wed to an emperor named Franz Joseph, Yet unexpectedly Franz runs into Sissi while out fishing and they fall in love.","popularity":3.6344,"poster_path":"/iGy9j4AdhkiOYRYeTSpq7g3zayL.jpg","release_date":"1955-12-22","softcore":false,"video":false,"vote_average":7.27,"vote_count":536},{"adult":false,"backdrop_path":"/xvcqme7lPw7nXNIQU71z11bbWRd.jpg","genre_ids":[18,35,10749],"id":458,"title":"Sissi: The Young Empress","original_language":"de","original_title":"Sissi - Die junge Kaiserin","overview":"Sissi is now the empress of Austria and attempts to learn etiquette. While she is busy being empress she also has to deal with her difficult new mother-in-law, while the arch-duchess Sophie is trying to tell the emperor how to rule and also Sissi how to be a mother.","popularity":3.9295,"poster_path":"/eGBCl0qGEwNbNu0nc5KOWYdBce4.jpg","release_date":"1956-12-01","softcore":false,"video":false,"vote_average":7,"vote_count":381},{"adult":false,"backdrop_path":"/5WuvIg4f2AdFPLUADFjxexVAb2H.jpg","genre_ids":[10749,18,36],"id":459,"title":"Sissi: The Fateful Years of an Empress","original_language":"de","original_title":"Sissi - Schicksalsjahre einer Kaiserin","overview":"After a wonderful time in Hungary Sissi falls extremely ill and must retreat to a Mediterranean climate to rest. The young empress’ mother takes her from Austria to recover in Madeira.","popularity":4.7669,"poster_path":"/o6B5zxNzWR6hvT77IbjjUXdCtEu.jpg","release_date":"1957-12-18","softcore":false,"video":false,"vote_average":7.1,"vote_count":363},{"adult":false,"backdrop_path":"/3HmLKhahTxX2ALTWlagr92pZrU7.jpg","genre_ids":[18],"id":462,"title":"Erin Brockovich","original_language":"en","original_title":"Erin Brockovich","overview":"A twice-divorced mother of three who sees an injustice, takes on the bad guy and wins -- with a little help from her push-up bra. Erin goes to work for an attorney and comes across medical records describing illnesses clustered in one nearby town. She starts